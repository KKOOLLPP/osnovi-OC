#include <windows.h>
#include <tchar.h>
#include <stdio.h>
#include <locale.h>

int main() {

	setlocale(LC_ALL, "Russian");

	HANDLE hMutexProcess = CreateMutex(NULL, FALSE, TEXT("myCounterMurtex")); // находитьься в свободном состоянии, индификатор и счетчик рекурсий 0
	if (hMutexProcess == NULL) {
		printf("Ошибка создания мьютекса: %lu\n", GetLastError());
		return 1; 
	}

	HANDLE hFileMap = CreateFileMapping(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE, 0, // выделение из системных файлов подкачик, автоматическое асвобождение
		sizeof(int), TEXT("myShareMemory"));

	DWORD dwError = GetLastError();

	if (hFileMap == NULL) {
		printf("Ошибка создания объекта памяти: %lu\n", GetLastError());
		CloseHandle(hMutexProcess);
		return 1;
	}

	BOOL isFirstInstance = (dwError != ERROR_ALREADY_EXISTS);

	int* CloudMemorryAdress = (int*)MapViewOfFile(hFileMap, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(int)); // смещение 64 разрядное число, количиство проецируемых байт 

	if (CloudMemorryAdress == NULL) {
		printf("Ошибка проецирования памяти: %lu\n", GetLastError());
		CloseHandle(hFileMap);
		CloseHandle(hMutexProcess);
		return 1;
	}

	WaitForSingleObject(hMutexProcess, INFINITE);
	
	if (isFirstInstance) {
		*CloudMemorryAdress = 1;
	}
	else {
		(*CloudMemorryAdress)++;
	}

	int currentCMA = *CloudMemorryAdress;

	ReleaseMutex(hMutexProcess);

	printf("Общее количество запусков программы: %d\n", currentCMA);
	printf("Нажмите Enter для выхода\n");
	 
	(void)getchar();

	UnmapViewOfFile(CloudMemorryAdress);
	CloseHandle(hFileMap);    
	CloseHandle(hMutexProcess);       

	return 0;
}
